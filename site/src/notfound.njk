---
layout: base.njk
noindex: true
pageKey: notFound
permalink: 404.html
---
{%- set t = text.en -%}
{%- set d = text.de -%}
<main>
  <section class="not-found dots">
    <div class="wrap">
      <span class="mono eyebrow-label">// 404</span>
      <h1>{{ t.notFound.title }}</h1>
      <p>{{ t.notFound.text }}</p>
      <a class="btn btn-primary" href="{{ t.paths.home }}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/></svg>
        <span>{{ t.notFound.back }}</span>
      </a>
      <p class="not-found-de" lang="de"><a href="{{ d.paths.home }}">{{ d.notFound.title }} {{ d.notFound.back }}</a></p>
    </div>
  </section>
</main>
