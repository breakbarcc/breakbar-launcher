<header class="site-header">
  <div class="wrap header-inner">
    <a href="{{ t.paths.home }}" class="brand">
      <span class="brand-icon"><img src="/assets/icon-48.png" width="32" height="32" alt="" decoding="async"></span>
      <span>{{ t.common.brand }}</span>
    </a>
    <nav class="main-nav" aria-label="{{ t.header.mainNav }}">
      <a href="{{ t.paths.home }}#features">{{ t.header.features }}</a>
      <a href="{{ t.paths.home }}#how">{{ t.header.how }}</a>
      <a href="{{ t.paths.home }}#download">{{ t.header.download }}</a>
      <a href="{{ site.urls.repo }}" rel="noopener">{{ t.header.github }}</a>
      <a href="{{ site.urls.main }}" rel="noopener">{{ t.header.main }}</a>
      {%- for other in locales %}{% set alt_path = text[other.code].paths[pageKey] %}{% if other.code != loc.code and alt_path %}
      <a href="{{ alt_path }}" hreflang="{{ other.code }}" lang="{{ other.code }}" class="lang-link">{{ other.short }}</a>
      {%- endif %}{% endfor %}
      <button type="button" class="theme-toggle" id="theme-toggle" aria-label="{{ t.header.toLight }}" data-to-light="{{ t.header.toLight }}" data-to-dark="{{ t.header.toDark }}">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      </button>
    </nav>
    <button type="button" class="menu-toggle" id="menu-toggle" aria-label="{{ t.header.menuOpen }}" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="{{ t.header.mobileNav }}">
    <a href="{{ t.paths.home }}#features">{{ t.header.features }}</a>
    <a href="{{ t.paths.home }}#how">{{ t.header.how }}</a>
    <a href="{{ t.paths.home }}#download">{{ t.header.download }}</a>
    <a href="{{ site.urls.repo }}" rel="noopener">{{ t.header.github }}</a>
    <a href="{{ site.urls.main }}" rel="noopener">{{ t.header.main }}</a>
    {%- for other in locales %}{% set alt_path = text[other.code].paths[pageKey] %}{% if other.code != loc.code and alt_path %}
    <a href="{{ alt_path }}" hreflang="{{ other.code }}" lang="{{ other.code }}">{{ text[loc.code].header.language }}</a>
    {%- endif %}{% endfor %}
    <button type="button" class="theme-toggle" id="theme-toggle-mobile" data-to-light="{{ t.header.toLight }}" data-to-dark="{{ t.header.toDark }}">{{ t.header.toggleTheme }}</button>
  </nav>
</header>
