<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="brand">
        <span class="brand-icon"><img src="/assets/icon-48.png" width="24" height="24" alt="" loading="lazy" decoding="async"></span>
        <span>{{ t.common.brand }}</span>
        <span class="mono footer-by">{{ t.common.by }}</span>
      </div>
      <nav class="footer-nav" aria-label="{{ t.footer.nav }}">
        <a href="{{ site.urls.repo }}" rel="noopener">{{ t.header.github }}</a>
        <a href="{{ site.urls.changelog }}" rel="noopener">{{ t.footer.changelog }}</a>
        <a href="{{ site.urls.license }}" rel="noopener">{{ t.footer.license }}</a>
        <a href="{{ site.urls.issues }}" rel="noopener">{{ t.common.reportProblem }}</a>
        <a href="{{ site.urls.main }}" rel="noopener">{{ t.header.main }}</a>
        <a href="{{ site.urls.imprint }}" rel="noopener">{{ t.footer.imprint }}</a>
        <a href="{{ site.urls.privacy }}" rel="noopener">{{ t.footer.privacy }}</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p class="disclaimer">{{ t.footer.disclaimer }}</p>
      <a class="slint-badge" href="{{ site.urls.slint }}" rel="noopener">
        <img class="slint-badge-dark" src="/assets/MadeWithSlint-logo-dark.svg" width="212" height="97" alt="{{ t.footer.slintAlt }}" loading="lazy" decoding="async">
        <img class="slint-badge-light" src="/assets/MadeWithSlint-logo-light.svg" width="212" height="97" alt="{{ t.footer.slintAlt }}" loading="lazy" decoding="async">
      </a>
    </div>
  </div>
</footer>
