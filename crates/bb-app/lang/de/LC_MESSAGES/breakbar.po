#: ui/messages.slint:62
msgctxt "Messages"
msgid "Exited (code {})"
msgstr "Beendet (Code {})"

#: ui/messages.slint:70
msgctxt "Messages"
msgid "Setting up „{}“"
msgstr "„{}“ wird eingerichtet"

#: ui/messages.slint:74
msgctxt "Messages"
msgid "Log in with „Remember email/password“ ticked, then close the client normally so the login is saved. Other accounts can be started afterwards."
msgstr "Logge dich mit „Zugangsdaten merken“ ein und schließe den Client danach normal, damit der Login gespeichert wird. Andere Accounts kannst du danach starten."

#: ui/messages.slint:78
msgctxt "Messages"
msgid "Unusually slow start"
msgstr "Ungewöhnlich langsamer Start"

#: ui/messages.slint:82
msgctxt "Messages"
msgid "„{}“ took unusually long to start. If it logs in with the wrong account, close it and start it again."
msgstr "„{}“ hat ungewöhnlich lange zum Starten gebraucht. Falls er mit dem falschen Account einloggt, schließe ihn und starte ihn erneut."

