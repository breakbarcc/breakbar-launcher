// Instance-switcher overlay (design hand-off section 6, screens 13-15). First pass: a grip to drag
// the bar, then one numbered chip per account (up to 4, running or not). A click on a running
// chip switches to its game window; a click on an idle one, or a right click on a running one,
// opens a menu (built and shown from Rust). Global hotkeys, other sizes, vertical orientation,
// opacity and the dedicated settings section (screen 15) come with a later refinement.
//
// The menus are native (Win32) popups (bb_win::menu), not Slint PopupWindows: this window is
// deliberately tiny, and an embedded Slint popup is clipped to its owning window's bounds on this
// backend, so it would be cut off rather than float over the screen like a real menu.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Spinner } from "components.slint";

/// One account shown as a numbered chip.
export struct SwitcherEntry {
    id: int,
    /// Only for accessibility; the bar itself never shows names (they made it reflow).
    name: string,
    /// Its client is running (or starting).
    running: bool,
    /// Its client is the current foreground window.
    active: bool,
    /// Still starting: shows a spinner instead of its number.
    starting: bool,
}

component Chip {
    in property <SwitcherEntry> entry;
    in property <int> number;
    callback clicked();
    /// Right click: Rust builds and shows the native menu.
    callback context-menu();

    // Every chip has the same fixed size whatever its state, so nothing ever reflows.
    height: 24px;
    width: 24px;
    accessible-role: button;
    accessible-label: entry.name;

    property <color> tone: entry.active ? Theme.accent : entry.running ? Theme.text-muted : Theme.text-dim;

    Rectangle {
        border-radius: 5px;
        background: entry.active ? Theme.overlay-chip-active
            : touch.has-hover ? Theme.overlay-chip-hover : transparent;
    }
    if entry.starting: Spinner {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 11px;
        color: root.tone;
    }
    if !entry.starting: Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.number;
        font-family: Theme.font-mono;
        font-size: 11px;
        font-weight: 600;
        color: root.tone;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                root.context-menu();
            }
        }
    }
}

export component OverlaySwitcher inherits Window {
    title: "Breakbar Switcher";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.fs-body;

    in property <[SwitcherEntry]> entries;
    /// Left click on a chip (by account id).
    callback chip-clicked(int);
    /// Right click on a chip (by account id).
    callback context-menu(int);

    preferred-width: bar.width;
    preferred-height: bar.height;

    hover := TouchArea { }

    bar := Rectangle {
        width: content.preferred-width;
        height: content.preferred-height;
        border-radius: Theme.radius-overlay;
        background: hover.has-hover ? Theme.overlay-hover : Theme.overlay-idle;
        border-width: 1px;
        border-color: hover.has-hover ? Theme.overlay-line : transparent;
        drop-shadow-color: hover.has-hover ? Theme.shadow-color : transparent;
        drop-shadow-blur: 32px;
        drop-shadow-offset-y: 12px;

        content := HorizontalLayout {
            spacing: 0px;
            // Drag handle: the full height of the bar and wide enough to grab. Only this strip
            // moves the window, so a click anywhere else is a click.
            Rectangle {
                width: 16px;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path: Icons.grip;
                    color: Theme.text-dim;
                    size: 12px;
                }
                WindowMoveArea { }
            }
            // Equal padding above, below and to the right of the chips.
            HorizontalLayout {
                padding-top: 3px;
                padding-bottom: 3px;
                padding-right: 3px;
                spacing: 1px;
                for entry[index] in root.entries: Chip {
                    entry: entry;
                    number: index + 1;
                    clicked => { root.chip-clicked(entry.id); }
                    context-menu => { root.context-menu(entry.id); }
                }
            }
        }
    }
}
