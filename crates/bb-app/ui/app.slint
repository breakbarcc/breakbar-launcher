import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import {
    Icon, Button, ButtonKind, IconButton, SectionLabel, LinkButton, SegmentBar, Toast, ToastData,
    ToastKind, Elevated,
} from "components.slint";
import { AccountCard, AccountRow, AccountState } from "account-card.slint";
import { AccountEditor, EditorData, CompanionToggle, LoginState } from "editor.slint";
import { SetupPathPage, SetupAccountPage } from "setup.slint";
import { SettingsPage } from "settings.slint";
import { Messages, LaunchFailure, PathProblem } from "messages.slint";

export {
    Theme, AccountRow, AccountState, ToastData, ToastKind, Messages, LaunchFailure, PathProblem,
    EditorData, CompanionToggle, LoginState,
}

export enum Page { accounts, editor, setup-path, setup-account, settings }

/// Skeleton card of the empty state.
component GhostCard inherits Rectangle {
    in property <length> line-width;
    height: 38px;
    border-radius: Theme.radius-card;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: 12px;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        border-width: 1.5px;
        border-color: Theme.line-2;
    }
    Rectangle {
        x: 38px;
        y: 11px;
        width: root.line-width;
        height: 6px;
        border-radius: 3px;
        background: Theme.line-2;
    }
    Rectangle {
        x: 38px;
        y: 22px;
        width: root.line-width * 0.55;
        height: 5px;
        border-radius: 3px;
        background: Theme.line;
    }
    Rectangle {
        x: parent.width - 60px;
        width: 48px;
        height: 18px;
        border-radius: 4px;
        background: Theme.surface-2;
    }
}

/// Asks before an account and its login are deleted for good.
component ConfirmDelete {
    in property <string> name;
    callback confirmed();
    callback cancelled();

    init => {
        cancel.focus();
    }

    // Scrim: dims the window and swallows clicks.
    Rectangle {
        background: Theme.bg.with-alpha(0.72);
        TouchArea {
            clicked => { root.cancelled(); }
        }
    }
    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancelled();
                return accept;
            }
            reject
        }
        Elevated {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.width - 32px, 340px);
            height: dialog.preferred-height;
            accessible-role: groupbox;
            accessible-label: @tr("Delete „{}“?", root.name);
            // Keeps clicks on the dialog from reaching the scrim.
            TouchArea { }
            dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: Icons.trash;
                        color: Theme.error;
                        size: 17px;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Delete „{}“?", root.name);
                        font-size: Theme.fs-page-title;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                }
                Text {
                    text: @tr("The account and its profile folder with the saved login are deleted for good. This cannot be undone.");
                    font-size: 12.5px;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 4px;
                    spacing: 8px;
                    alignment: end;
                    cancel := Button {
                        kind: ButtonKind.ghost;
                        text: @tr("Cancel");
                        clicked => { root.cancelled(); }
                    }
                    Button {
                        kind: ButtonKind.danger;
                        icon: Icons.trash;
                        text: @tr("Delete");
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: root.page == Page.setup-path || root.page == Page.setup-account
        ? @tr("Breakbar Launcher – Setup") : "Breakbar Launcher";
    icon: @image-url("../assets/icon/breakbar-64.png");
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.fs-body;
    preferred-width: 420px;
    preferred-height: 520px;
    min-width: 320px;
    min-height: 360px;

    in property <[AccountRow]> accounts;
    in property <int> running-count;
    in property <int> starting-count;
    in property <int> selected-count;
    in property <string> gw2-path;
    in property <bool> gw2-path-ok;
    /// Path to `Blish HUD.exe`; empty if not configured.
    in property <string> blish-path;
    in property <bool> blish-path-ok;
    in property <bool> autostart;
    in property <[ToastData]> toasts;
    in-out property <Page> page: Page.accounts;
    /// What the editor page shows; set by Rust before switching to it.
    in property <EditorData> editor;
    /// First-start setup: the client found automatically, and the one chosen by hand.
    in property <string> setup-detected-path;
    in property <string> setup-other-path;
    in property <string> setup-other-error;

    /// Start the account if idle, stop it if running.
    callback launch-account(int);
    /// Start the client without `-shareArchive` so a remembered login can be saved.
    callback set-up-login(int);
    /// Start all idle accounts, or only the selected ones if there is a selection.
    callback launch-all();
    callback toggle-selected(int);
    callback clear-selection();
    callback choose-gw2-path();
    callback choose-blish-path();
    callback toggle-autostart();
    /// Open the editor for an account (0 = a new one).
    callback edit-account(int);
    /// Editor: switch a companion app for the account being edited.
    callback editor-toggle-companion(int);
    /// Editor: save. Name, whether it is a Steam account, extra launch arguments.
    callback editor-save(string, bool, string);
    callback duplicate-account(int);
    callback create-shortcut(int);
    callback open-profile-folder(int);
    /// Delete the account and its profile folder (after the user confirmed).
    callback delete-account(int);
    /// Move account `id` to list position `index`.
    callback move-account(int, int);
    callback setup-browse();
    callback setup-path-chosen(string);
    /// Name and whether it is a Steam account.
    callback setup-create-account(string, bool);
    callback dismiss-toast(int);
    /// The theme switched between dark and light (the native title bar has to follow).
    callback theme-changed(bool);

    /// Id of the toast under the pointer (0 if none); it stays while hovered.
    out property <int> hovered-toast;

    property <bool> compact: self.width < 360px;
    property <bool> dark: Theme.dark;

    // Delete confirmation: account id (0 = no dialog) and name.
    property <int> confirm-delete-id;
    property <string> confirm-delete-name;

    // Drag & drop: the dragged row (-1 = none), where the pointer grabbed it, and the pointer
    // position, both relative to the top of the list.
    property <int> drag-index: -1;
    property <length> drag-grab;
    property <length> drag-pointer;
    /// Height of a row plus the gap to the next one.
    property <length> row-pitch: Theme.row-height + 4px;
    property <length> drag-top: root.drag-pointer - root.drag-grab;
    property <int> drag-target: max(0, min(root.accounts.length - 1, round(root.drag-top / root.row-pitch)));

    changed dark => { root.theme-changed(self.dark); }

    function request-delete(id: int, name: string) {
        root.confirm-delete-id = id;
        root.confirm-delete-name = name;
    }

    // ── Accounts page ────────────────────────────────────────────────────────────────────────
    if root.page == Page.accounts: VerticalLayout {
        // Toolbar: launch button, running counter, add.
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;

            Button {
                y: (parent.height - self.height) / 2;
                large: true;
                kind: ButtonKind.primary;
                icon: Icons.play;
                enabled: root.accounts.length > 0;
                text: root.selected-count > 0
                    ? (root.compact ? @tr("Start · {}", root.selected-count) : @tr("Start selection · {}", root.selected-count))
                    : (root.compact ? @tr("All") : @tr("Launch all"));
                clicked => { root.launch-all(); }
            }

            VerticalLayout {
                width: root.compact ? 64px : 96px;
                spacing: 5px;
                alignment: center;
                accessible-role: text;
                accessible-label: @tr("{} of {} clients running", root.running-count, root.accounts.length);
                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;
                    HorizontalLayout {
                        Text {
                            text: root.running-count;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-name;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Text {
                            text: "/" + root.accounts.length;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-name;
                            font-weight: 600;
                            color: Theme.text-dim;
                        }
                    }
                    if !root.compact: Text {
                        horizontal-stretch: 1;
                        text: @tr("RUNNING");
                        font-family: Theme.font-mono;
                        font-size: 10.5px;
                        letter-spacing: 0.8px;
                        color: Theme.text-dim;
                        vertical-alignment: bottom;
                    }
                }
                SegmentBar {
                    total: root.accounts.length;
                    full: root.running-count;
                    partial: root.starting-count;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.plus;
                label: @tr("Add account");
                clicked => { root.edit-account(0); }
            }

            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.settings;
                label: @tr("Settings");
                clicked => { root.page = Page.settings; }
            }
        }

        if root.accounts.length == 0: VerticalLayout {
            vertical-stretch: 1;
            padding-left: 24px;
            padding-right: 24px;
            spacing: 10px;
            alignment: center;

            VerticalLayout {
                padding-left: 48px;
                padding-right: 48px;
                padding-bottom: 20px;
                spacing: 6px;
                GhostCard {
                    line-width: 120px;
                }
                GhostCard {
                    line-width: 90px;
                    opacity: 0.7;
                }
                GhostCard {
                    line-width: 105px;
                    opacity: 0.35;
                }
            }
            Text {
                text: @tr("No accounts yet");
                font-size: 19px;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: @tr("Add an account and start it with one click. Several accounts run side by side.");
                color: Theme.text-muted;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            HorizontalLayout {
                padding-top: 8px;
                alignment: center;
                Button {
                    large: true;
                    kind: ButtonKind.primary;
                    icon: Icons.plus;
                    text: @tr("Add account");
                    clicked => { root.edit-account(0); }
                    init => { self.focus(); }
                }
            }
        }

        if root.accounts.length > 0: HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 2px;
            padding-bottom: 6px;
            height: 26px;
            SectionLabel {
                horizontal-stretch: 1;
                text: @tr("// ACCOUNTS · {}", root.accounts.length);
                vertical-alignment: center;
            }
            if root.drag-index >= 0: SectionLabel {
                text: @tr("POS {}/{}", root.drag-target + 1, root.accounts.length);
                color: Theme.accent;
                vertical-alignment: center;
            }
            if root.drag-index < 0 && root.selected-count > 0: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: @tr("{} selected", root.selected-count);
                    font-size: Theme.fs-help;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                LinkButton {
                    text: @tr("Clear");
                    clicked => { root.clear-selection(); }
                }
            }
            if root.drag-index < 0 && root.selected-count == 0 && root.accounts.length > 1 && !root.compact: Text {
                text: @tr("Drag to sort");
                font-size: Theme.fs-help;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }

        if root.accounts.length > 0: Flickable {
            vertical-stretch: 1;
            // Scrolling would fight the drag gesture.
            interactive: root.drag-index < 0;
            content-height: list.height;

            list := Rectangle {
                height: root.accounts.length * root.row-pitch + 6px;

                for account[index] in root.accounts: AccountCard {
                    x: 10px;
                    y: index * root.row-pitch;
                    width: parent.width - 20px;
                    account: account;
                    compact: root.compact;
                    placeholder: root.drag-index == index;
                    action => { root.launch-account(account.id); }
                    toggle-selected => { root.toggle-selected(account.id); }
                    edit => { root.edit-account(account.id); }
                    duplicate => { root.duplicate-account(account.id); }
                    create-shortcut => { root.create-shortcut(account.id); }
                    open-folder => { root.open-profile-folder(account.id); }
                    request-delete => { root.request-delete(account.id, account.name); }
                    move-by(delta) => { root.move-account(account.id, index + delta); }
                    drag-started(y) => {
                        root.drag-index = index;
                        root.drag-grab = y;
                        root.drag-pointer = index * root.row-pitch + y;
                    }
                    drag-moved(y) => {
                        root.drag-pointer = index * root.row-pitch + y;
                    }
                    drag-ended => {
                        if root.drag-target != index {
                            root.move-account(account.id, root.drag-target);
                        }
                        root.drag-index = -1;
                    }
                }

                // Insertion line: 2 px accent with a ring at its start.
                if root.drag-index >= 0 && root.drag-target != root.drag-index: Rectangle {
                    x: 4px;
                    y: root.drag-target < root.drag-index
                        ? root.drag-target * root.row-pitch - 3px
                        : root.drag-target * root.row-pitch + Theme.row-height + 1px;
                    width: parent.width - 14px;
                    height: 2px;
                    background: Theme.accent;
                    Rectangle {
                        x: -2px;
                        y: -3px;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: Theme.accent;
                        background: Theme.bg;
                    }
                }

                // The dragged row follows the pointer, slightly turned.
                if root.drag-index >= 0: AccountCard {
                    x: 18px;
                    y: max(-8px, min(parent.height - Theme.row-height, root.drag-top));
                    width: parent.width - 28px;
                    transform-rotation: -1deg;
                    account: root.accounts[root.drag-index];
                    compact: root.compact;
                    dragging: true;
                }
            }
        }
    }

    // ── Account editor ───────────────────────────────────────────────────────────────────────
    if root.page == Page.editor: AccountEditor {
        data: root.editor;
        save(name, steam, args) => { root.editor-save(name, steam, args); }
        cancel => { root.page = Page.accounts; }
        request-delete => { root.request-delete(root.editor.id, root.editor.name); }
        set-up-login => {
            root.page = Page.accounts;
            root.set-up-login(root.editor.id);
        }
        toggle-companion(id) => { root.editor-toggle-companion(id); }
    }

    // ── First-start setup ────────────────────────────────────────────────────────────────────
    if root.page == Page.setup-path: SetupPathPage {
        detected-path: root.setup-detected-path;
        other-path: root.setup-other-path;
        other-error: root.setup-other-error;
        browse => { root.setup-browse(); }
        next(path) => { root.setup-path-chosen(path); }
    }
    if root.page == Page.setup-account: SetupAccountPage {
        back => { root.page = Page.setup-path; }
        create(name, steam) => { root.setup-create-account(name, steam); }
    }

    // ── Settings ─────────────────────────────────────────────────────────────────────────────
    if root.page == Page.settings: SettingsPage {
        gw2-path: root.gw2-path;
        gw2-path-ok: root.gw2-path-ok;
        blish-path: root.blish-path;
        blish-path-ok: root.blish-path-ok;
        autostart: root.autostart;
        back => { root.page = Page.accounts; }
        choose-gw2-path => { root.choose-gw2-path(); }
        choose-blish-path => { root.choose-blish-path(); }
        toggle-autostart => { root.toggle-autostart(); }
    }

    // ── Toasts ───────────────────────────────────────────────────────────────────────────────
    // Stacked from the bottom edge. The layout spans the window but only the toasts take input.
    if root.toasts.length > 0: VerticalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        padding: 12px;
        spacing: 8px;
        alignment: end;
        for toast in root.toasts: Toast {
            data: toast;
            dismissed => { root.dismiss-toast(toast.id); }
            hover-changed(hovered) => {
                if hovered {
                    root.hovered-toast = toast.id;
                } else if root.hovered-toast == toast.id {
                    root.hovered-toast = 0;
                }
            }
        }
    }

    // ── Delete confirmation ──────────────────────────────────────────────────────────────────
    if root.confirm-delete-id != 0: ConfirmDelete {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        name: root.confirm-delete-name;
        confirmed => {
            root.delete-account(root.confirm-delete-id);
            root.confirm-delete-id = 0;
        }
        cancelled => { root.confirm-delete-id = 0; }
    }
}
