// Texts the Rust side shows (toasts, card details). They live here so that all user-visible
// text is translated in one place, through Slint's `@tr`.

import { AccountState } from "account-card.slint";

export enum LaunchFailure {
    no-game-path,
    steam-not-running,
    steam-install-missing,
    setup-needs-exclusive,
    setup-client-running,
    already-running,
    profile,
    profile-link,
    spawn,
    exited-during-startup,
}

export enum PathProblem { not-found, unreadable, not-executable, not-64-bit, not-gw2 }

export global Messages {
    public pure function start-failed() -> string {
        @tr("Start failed")
    }

    /// Why starting `name` failed. `detail` is the OS error or exit code, where there is one.
    public pure function launch-failure(kind: LaunchFailure, name: string, detail: string) -> string {
        if kind == LaunchFailure.no-game-path {
            return @tr("Guild Wars 2 is not configured yet.");
        }
        if kind == LaunchFailure.steam-not-running {
            return @tr("„{}“ is a Steam account: start Steam and sign in with the Steam user it is linked to first.", name);
        }
        if kind == LaunchFailure.steam-install-missing {
            return @tr("„{}“ is a Steam account, but no Guild Wars 2 installation with Steam support was found. Install Guild Wars 2 through Steam; that installation can be used for all accounts.", name);
        }
        if kind == LaunchFailure.setup-needs-exclusive {
            return @tr("Setting up the login of „{}“ needs all other Guild Wars 2 clients to be closed first.", name);
        }
        if kind == LaunchFailure.setup-client-running {
            return @tr("An account is currently being set up. Close that client before starting another one.");
        }
        if kind == LaunchFailure.already-running {
            return @tr("„{}“ is already running.", name);
        }
        if kind == LaunchFailure.profile {
            return @tr("„{}“: the profile folder could not be prepared: {}", name, detail);
        }
        if kind == LaunchFailure.profile-link {
            return @tr("„{}“: Guild Wars 2 could not be switched to this account's profile: {}", name, detail);
        }
        if kind == LaunchFailure.spawn {
            return @tr("„{}“: Gw2-64.exe could not be started: {}", name, detail);
        }
        @tr("„{}“: Gw2-64.exe closed during startup (code {}).", name, detail)
    }

    public pure function exited-title() -> string {
        @tr("Client exited")
    }

    public pure function exited(name: string, code: string) -> string {
        @tr("„{}“: Gw2-64.exe exited (code {}).", name, code)
    }

    /// Card detail after "Error · ".
    public pure function exited-detail(code: string) -> string {
        @tr("Exited (code {})", code)
    }

    public pure function start-failed-detail() -> string {
        @tr("Start failed")
    }

    public pure function setting-up-title(name: string) -> string {
        @tr("Setting up „{}“", name)
    }

    public pure function setting-up() -> string {
        @tr("Log in with „Remember email/password“ ticked, then close the client normally so the login is saved. Other accounts can be started afterwards.")
    }

    public pure function slow-start-title() -> string {
        @tr("Unusually slow start")
    }

    public pure function slow-start(name: string) -> string {
        @tr("„{}“ took unusually long to start. If it logs in with the wrong account, close it and start it again.", name)
    }

    public pure function profile-restore-title() -> string {
        @tr("Profile not switched back")
    }

    public pure function profile-restore(detail: string) -> string {
        @tr("Guild Wars 2's data folder could not be switched back to the shared profile: {}", detail)
    }

    public pure function companion-failed-title(app: string) -> string {
        @tr("{} could not be started", app)
    }

    public pure function steam-busy-title() -> string {
        @tr("Steam account already running")
    }

    public pure function steam-busy(name: string, running: string) -> string {
        @tr("„{}“ is locked until „{}“ has exited.", name, running)
    }

    public pure function stop-failed-title() -> string {
        @tr("Client could not be stopped")
    }

    public pure function settings-load-failed(detail: string) -> string {
        @tr("Settings could not be loaded, changes won't be saved: {}", detail)
    }

    public pure function settings-save-failed(detail: string) -> string {
        @tr("Settings could not be saved: {}", detail)
    }

    public pure function settings-title() -> string {
        @tr("Settings")
    }

    public pure function autostart-failed-title() -> string {
        @tr("Could not change the Windows startup setting")
    }

    public pure function autostart-failed(detail: string) -> string {
        @tr("{}", detail)
    }

    /// Tray menu: "Launch all" with a counter of accounts it would start.
    public pure function tray-launch-all(count: int) -> string {
        @tr("Launch all ({})", count)
    }

    /// Tray menu: one entry per account, name plus a short status word.
    public pure function tray-account(name: string, state: AccountState) -> string {
        if state == AccountState.needs-login {
            return @tr("{} · Login required", name);
        }
        if state == AccountState.starting {
            return @tr("{} · Starting…", name);
        }
        if state == AccountState.running {
            return @tr("{} · Running", name);
        }
        if state == AccountState.stopping {
            return @tr("{} · Stopping…", name);
        }
        if state == AccountState.locked {
            return @tr("{} · Locked", name);
        }
        if state == AccountState.error {
            return @tr("{} · Error", name);
        }
        @tr("{} · Ready", name)
    }

    public pure function tray-open-window() -> string {
        @tr("Open window")
    }

    public pure function tray-quit() -> string {
        @tr("Quit")
    }

    public pure function tray-failed-title() -> string {
        @tr("Tray icon could not be created")
    }

    public pure function overlay-start() -> string {
        @tr("Start")
    }

    public pure function overlay-stop() -> string {
        @tr("Stop")
    }

    public pure function overlay-failed-title() -> string {
        @tr("Switcher overlay could not be created")
    }

    public pure function steam-setup-ready-title() -> string {
        @tr("Steam is ready")
    }

    public pure function steam-setup-ready(name: string) -> string {
        @tr("You can start „{}“ now.", name)
    }

    public pure function steam-setup-failed-title() -> string {
        @tr("The link to Steam could not be created")
    }

    public pure function steam-setup-blocked(path: string) -> string {
        @tr("„{}“ already exists and does not point to your Guild Wars 2 installation. Remove or rename it, or install Guild Wars 2 through Steam.", path)
    }

    public pure function dialog-failed(detail: string) -> string {
        @tr("The file dialog could not be opened: {}", detail)
    }

    public pure function set-path-first() -> string {
        @tr("Choose the Guild Wars 2 client first.")
    }

    public pure function path-invalid-title() -> string {
        @tr("Not the Guild Wars 2 client")
    }

    public pure function path-unusable-title() -> string {
        @tr("Guild Wars 2 client not usable")
    }

    /// Name of a duplicated account.
    public pure function copy-name(name: string) -> string {
        @tr("{} (copy)", name)
    }

    public pure function shortcut-created-title() -> string {
        @tr("Desktop shortcut created")
    }

    public pure function shortcut-created(file: string) -> string {
        @tr("„{}“ starts the account without opening the launcher.", file)
    }

    public pure function shortcut-failed-title() -> string {
        @tr("Shortcut could not be created")
    }

    /// Tooltip of a desktop shortcut.
    public pure function shortcut-description(name: string) -> string {
        @tr("Start „{}“ with Breakbar", name)
    }

    public pure function deleted-title(name: string) -> string {
        @tr("„{}“ deleted", name)
    }

    public pure function delete-failed-title() -> string {
        @tr("Profile folder could not be deleted")
    }

    public pure function delete-running(name: string) -> string {
        @tr("„{}“ is running. Stop it before deleting it.", name)
    }

    public pure function folder-failed-title() -> string {
        @tr("Profile folder could not be opened")
    }

    /// Starting from a shortcut or the command line: an account name or id that doesn't exist.
    public pure function unknown-account(name: string) -> string {
        @tr("There is no account „{}“.", name)
    }

    public pure function path-problem(kind: PathProblem, detail: string) -> string {
        if kind == PathProblem.not-found {
            return @tr("The file does not exist.");
        }
        if kind == PathProblem.unreadable {
            return @tr("The file could not be read: {}", detail);
        }
        if kind == PathProblem.not-executable {
            return @tr("The file is not a Windows program.");
        }
        if kind == PathProblem.not-64-bit {
            return @tr("Only the 64-bit client (Gw2-64.exe) is supported.");
        }
        @tr("The file is not the Guild Wars 2 client.")
    }
}
