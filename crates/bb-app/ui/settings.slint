// Settings page (design hand-off: screen 11). Only the "// Pfade" section for now; the other
// sections (companion apps, behavior, appearance, about) come with later steps.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Button, IconButton, SectionLabel, FieldLabel, Toggle } from "components.slint";

/// A configured executable path: a mono display field, a "Browse…" button, and a status line
/// once a path is set.
component PathField {
    in property <string> label;
    in property <string> path;
    in property <bool> ok;
    /// Shown (in `ok` color) once a path is set and valid.
    in property <string> ok-text;
    /// Shown (in `error` color) once a path is set but invalid.
    in property <string> error-text;
    callback browse();

    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: root.label;
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.input-height;
                border-radius: Theme.radius-control;
                background: Theme.input;
                border-width: 1px;
                border-color: !root.ok && root.path != "" ? Theme.error : Theme.line-2;
                clip: true;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        vertical-alignment: center;
                        text: root.path == "" ? "—" : root.path;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-help;
                        color: root.path == "" ? Theme.text-dim : Theme.text;
                        overflow: elide;
                    }
                }
            }
            Button {
                icon: Icons.folder;
                icon-color: Theme.text-muted;
                text: @tr("Browse…");
                clicked => { root.browse(); }
            }
        }
        if root.path != "": HorizontalLayout {
            spacing: 6px;
            Icon {
                y: (parent.height - self.height) / 2;
                path: root.ok ? Icons.checkcircle : Icons.xcircle;
                color: root.ok ? Theme.ok : Theme.error;
                size: 13px;
                weight: 2;
            }
            Text {
                horizontal-stretch: 1;
                text: root.ok ? root.ok-text : root.error-text;
                font-size: Theme.fs-help;
                color: root.ok ? Theme.ok : Theme.error;
                wrap: word-wrap;
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    in property <string> gw2-path;
    in property <bool> gw2-path-ok;
    in property <string> blish-path;
    in property <bool> blish-path-ok;
    in property <bool> autostart;
    callback back();
    callback choose-gw2-path();
    callback choose-blish-path();
    callback toggle-autostart();

    // Header: back arrow, title (matches the account editor's).
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.back;
            label: @tr("Back");
            clicked => { root.back(); }
        }
        Text {
            text: @tr("Settings");
            font-size: Theme.fs-page-title;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.line;
    }

    Flickable {
        vertical-stretch: 1;
        content-height: content.preferred-height;

        content := VerticalLayout {
            padding: 16px;
            spacing: 14px;
            alignment: start;

            SectionLabel {
                text: @tr("// PATHS");
            }
            PathField {
                label: "Guild Wars 2";
                path: root.gw2-path;
                ok: root.gw2-path-ok;
                ok-text: @tr("Gw2-64.exe found");
                error-text: @tr("File not found. Check the path.");
                browse => { root.choose-gw2-path(); }
            }
            PathField {
                label: "Blish HUD";
                path: root.blish-path;
                ok: root.blish-path-ok;
                ok-text: @tr("Blish HUD.exe found");
                error-text: @tr("File not found. Check the path.");
                browse => { root.choose-blish-path(); }
            }

            SectionLabel {
                text: @tr("// BEHAVIOR");
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: @tr("Start with Windows");
                        font-size: Theme.fs-body;
                        color: Theme.text;
                    }
                    Text {
                        text: @tr("Opens the launcher when you sign in.");
                        font-size: Theme.fs-help;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                Toggle {
                    y: (parent.height - self.height) / 2;
                    checked: root.autostart;
                    label: @tr("Start with Windows");
                    toggled => { root.toggle-autostart(); }
                }
            }
        }
    }
}
