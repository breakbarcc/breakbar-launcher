// Settings page (design hand-off: screen 11). Paths and behavior so far; the other sections
// (companion apps, appearance, about) come with later steps.

import { Theme, ThemeChoice } from "theme.slint";
import { Icons } from "icons.slint";
import { Activation, Icon, Button, FocusRing, IconButton, SectionLabel, FieldLabel, Toggle, Segmented, LinkButton, Slider } from "components.slint";

/// What happens to the main window right after starting an account (not on setup or a manual
/// stop). Mirrors `bb_store::AfterStart`.
export enum AfterStart { keep-open, minimize-to-tray, close }

/// Frame rate limit passed to the game (`-fps:N`). Mirrors `bb_store::FpsLimit`.
export enum FpsLimit { fps60, fps30, unlimited }

/// Language of the UI. Mirrors `bb_store::LanguageChoice`.
export enum LanguageChoice { system, english, german }

/// One row of the "Nach dem Start" radio group: a plain radio dot plus a label, no card chrome.
component RadioOption {
    in property <string> text;
    in property <bool> checked;
    callback selected();

    height: 34px;
    forward-focus: focus;
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checked: root.checked;

    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 1.5px;
            border-color: root.checked ? Theme.primary : Theme.line-3;
            if root.checked: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.primary;
            }
        }
        Text {
            vertical-alignment: center;
            text: root.text;
            font-size: Theme.fs-body;
            color: Theme.text;
        }
    }
    if focus.has-focus: FocusRing {
        radius: 6px;
        around-width: root.width;
        around-height: root.height;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.selected();
        }
    }
    focus := Activation {
        activated => { root.selected(); }
    }
}

/// A configured executable path: a mono display field, a "Browse…" button, and a status line
/// once a path is set.
component PathField {
    in property <string> label;
    in property <string> path;
    in property <bool> ok;
    /// Shown (in `ok` color) once a path is set and valid.
    in property <string> ok-text;
    /// Shown (in `error` color) once a path is set but invalid.
    in property <string> error-text;
    callback browse();

    VerticalLayout {
        spacing: 6px;
        FieldLabel {
            text: root.label;
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                height: Theme.input-height;
                border-radius: Theme.radius-control;
                background: Theme.input;
                border-width: 1px;
                border-color: !root.ok && root.path != "" ? Theme.error : Theme.line-2;
                clip: true;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        vertical-alignment: center;
                        text: root.path == "" ? "—" : root.path;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-help;
                        color: root.path == "" ? Theme.text-dim : Theme.text;
                        overflow: elide;
                    }
                }
            }
            Button {
                icon: Icons.folder;
                icon-color: Theme.text-muted;
                text: @tr("Browse…");
                clicked => { root.browse(); }
            }
        }
        if root.path != "": HorizontalLayout {
            spacing: 6px;
            Icon {
                y: (parent.height - self.height) / 2;
                path: root.ok ? Icons.checkcircle : Icons.xcircle;
                color: root.ok ? Theme.ok : Theme.error;
                size: 13px;
                weight: 2;
            }
            Text {
                horizontal-stretch: 1;
                text: root.ok ? root.ok-text : root.error-text;
                font-size: Theme.fs-help;
                color: root.ok ? Theme.ok : Theme.error;
                wrap: word-wrap;
            }
        }
    }
}

/// A setting with a switch: title and a help line on the left.
component ToggleRow {
    in property <string> text;
    in property <string> help;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    HorizontalLayout {
        spacing: 12px;
        opacity: root.enabled ? 1 : 0.42;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.text;
                font-size: Theme.fs-body;
                color: Theme.text;
            }
            Text {
                text: root.help;
                font-size: Theme.fs-help;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }
        Toggle {
            y: (parent.height - self.height) / 2;
            checked: root.checked;
            enabled: root.enabled;
            label: root.text;
            toggled(value) => { root.toggled(value); }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    in property <string> gw2-path;
    in property <bool> gw2-path-ok;
    in property <string> blish-path;
    in property <bool> blish-path-ok;
    in property <bool> autostart;
    in property <AfterStart> after-start;
    in property <FpsLimit> fps-limit;
    in property <LanguageChoice> language;
    in property <bool> overlay-enabled;
    in property <bool> overlay-only-running;
    in property <bool> overlay-locked;
    /// Opacity of the switcher at rest, in percent (30 to 100).
    in property <int> overlay-opacity;
    /// Version of Breakbar, shown in the About section.
    in property <string> version;
    callback back();
    callback choose-gw2-path();
    callback choose-blish-path();
    callback toggle-autostart();
    callback set-after-start(AfterStart);
    callback set-fps-limit(FpsLimit);
    callback set-theme(ThemeChoice);
    callback set-language(LanguageChoice);
    callback set-overlay-enabled(bool);
    callback set-overlay-only-running(bool);
    callback set-overlay-locked(bool);
    callback set-overlay-opacity(int);
    callback open-website();
    callback open-license();
    callback open-slint();

    // Header: back arrow, title (matches the account editor's).
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.back;
            label: @tr("Back");
            clicked => { root.back(); }
        }
        Text {
            text: @tr("Settings");
            font-size: Theme.fs-page-title;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 1px;
        background: Theme.line;
    }

    Flickable {
        vertical-stretch: 1;
        content-height: content.preferred-height;

        content := VerticalLayout {
            padding: 16px;
            spacing: 14px;
            alignment: start;

            SectionLabel {
                text: @tr("// PATHS");
            }
            PathField {
                label: "Guild Wars 2";
                path: root.gw2-path;
                ok: root.gw2-path-ok;
                ok-text: @tr("Gw2-64.exe found");
                error-text: @tr("File not found. Check the path.");
                browse => { root.choose-gw2-path(); }
            }
            PathField {
                label: "Blish HUD";
                path: root.blish-path;
                ok: root.blish-path-ok;
                ok-text: @tr("Blish HUD.exe found");
                error-text: @tr("File not found. Check the path.");
                browse => { root.choose-blish-path(); }
            }

            SectionLabel {
                text: @tr("// GAME");
            }
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: @tr("Frame rate limit for loading screens");
                    font-size: Theme.fs-help;
                    font-weight: 600;
                    color: Theme.text-muted;
                }
                Segmented {
                    options: [@tr("60 FPS"), @tr("30 FPS"), @tr("Unlimited")];
                    selected: root.fps-limit == FpsLimit.fps60 ? 0 : root.fps-limit == FpsLimit.fps30 ? 1 : 2;
                    changed(index) => {
                        root.set-fps-limit(index == 0 ? FpsLimit.fps60 : index == 1 ? FpsLimit.fps30 : FpsLimit.unlimited);
                    }
                }
                Text {
                    text: @tr("Only limits the loading screens. It does not apply in the game world or on the character selection screen, and has nothing to do with the Frame Limiter in the game's graphics options.");
                    font-size: Theme.fs-help;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }

            SectionLabel {
                text: @tr("// BEHAVIOR");
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: @tr("After starting an account");
                    font-size: Theme.fs-help;
                    font-weight: 600;
                    color: Theme.text-muted;
                }
                RadioOption {
                    text: @tr("Keep the window open");
                    checked: root.after-start == AfterStart.keep-open;
                    selected => { root.set-after-start(AfterStart.keep-open); }
                }
                RadioOption {
                    text: @tr("Minimize to the tray");
                    checked: root.after-start == AfterStart.minimize-to-tray;
                    selected => { root.set-after-start(AfterStart.minimize-to-tray); }
                }
                RadioOption {
                    text: @tr("Close the launcher");
                    checked: root.after-start == AfterStart.close;
                    selected => { root.set-after-start(AfterStart.close); }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text {
                        text: @tr("Start with Windows");
                        font-size: Theme.fs-body;
                        color: Theme.text;
                    }
                    Text {
                        text: @tr("Opens the launcher when you sign in.");
                        font-size: Theme.fs-help;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
                Toggle {
                    y: (parent.height - self.height) / 2;
                    checked: root.autostart;
                    label: @tr("Start with Windows");
                    toggled => { root.toggle-autostart(); }
                }
            }

            SectionLabel {
                text: @tr("// SWITCHER");
            }
            ToggleRow {
                text: @tr("Show the switcher");
                help: @tr("A small bar over the game to jump between clients.");
                checked: root.overlay-enabled;
                toggled(value) => { root.set-overlay-enabled(value); }
            }
            ToggleRow {
                text: @tr("Only while a client is running");
                help: @tr("Otherwise it stays on screen as long as Breakbar runs.");
                enabled: root.overlay-enabled;
                checked: root.overlay-only-running;
                toggled(value) => { root.set-overlay-only-running(value); }
            }
            ToggleRow {
                text: @tr("Lock the position");
                help: @tr("The bar can no longer be dragged.");
                enabled: root.overlay-enabled;
                checked: root.overlay-locked;
                toggled(value) => { root.set-overlay-locked(value); }
            }
            VerticalLayout {
                spacing: 6px;
                opacity: root.overlay-enabled ? 1 : 0.42;
                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Opacity at rest");
                        font-size: Theme.fs-help;
                        font-weight: 600;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: root.overlay-opacity + " %";
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-help;
                        color: Theme.text-muted;
                    }
                }
                Slider {
                    enabled: root.overlay-enabled;
                    label: @tr("Opacity at rest");
                    minimum: 30;
                    maximum: 100;
                    value: root.overlay-opacity;
                    changed(value) => { root.set-overlay-opacity(value); }
                }
                Text {
                    text: @tr("Under the pointer the bar is always fully opaque. It is visible over windows and borderless fullscreen, not over exclusive fullscreen.");
                    font-size: Theme.fs-help;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }

            SectionLabel {
                text: @tr("// APPEARANCE");
            }
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: @tr("Theme");
                    font-size: Theme.fs-help;
                    font-weight: 600;
                    color: Theme.text-muted;
                }
                Segmented {
                    options: [@tr("System"), @tr("Light"), @tr("Dark")];
                    selected: Theme.choice == ThemeChoice.system ? 0 : Theme.choice == ThemeChoice.light ? 1 : 2;
                    changed(index) => {
                        root.set-theme(index == 0 ? ThemeChoice.system : index == 1 ? ThemeChoice.light : ThemeChoice.dark);
                    }
                }
                Text {
                    text: @tr("System follows the Windows app theme.");
                    font-size: Theme.fs-help;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text {
                    text: @tr("Language");
                    font-size: Theme.fs-help;
                    font-weight: 600;
                    color: Theme.text-muted;
                }
                Segmented {
                    // The language names are shown in their own language on purpose.
                    options: [@tr("System"), "English", "Deutsch"];
                    selected: root.language == LanguageChoice.system ? 0 : root.language == LanguageChoice.english ? 1 : 2;
                    changed(index) => {
                        root.set-language(index == 0 ? LanguageChoice.system : index == 1 ? LanguageChoice.english : LanguageChoice.german);
                    }
                }
                Text {
                    text: @tr("System follows the Windows display language.");
                    font-size: Theme.fs-help;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
            }

            SectionLabel {
                text: @tr("// ABOUT");
            }
            Rectangle {
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.line;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 14px;
                        Image {
                            source: @image-url("../assets/icon/breakbar-48.png");
                            width: 48px;
                            height: 48px;
                            accessible-role: none;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: "Breakbar Launcher";
                                font-size: 17px;
                                font-weight: 700;
                                color: Theme.text;
                            }
                            Text {
                                text: @tr("Version {} · breakbar.cc", root.version);
                                font-family: Theme.font-mono;
                                font-size: 11.5px;
                                color: Theme.text-dim;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;
                        LinkButton {
                            text: "breakbar.cc";
                            clicked => { root.open-website(); }
                        }
                        LinkButton {
                            text: @tr("License");
                            clicked => { root.open-license(); }
                        }
                    }
                    // The official "Made with Slint" badge (Slint's license asks for it), in the variant
                    // that stands out from the card: a white pill on the dark theme, a dark one on the
                    // light theme. A click opens slint.dev.
                    HorizontalLayout {
                        alignment: start;
                        Image {
                            source: Theme.dark
                                ? @image-url("../assets/badge/MadeWithSlint-logo-dark.svg")
                                : @image-url("../assets/badge/MadeWithSlint-logo-light.svg");
                            width: 87px;
                            height: 40px;
                            image-fit: contain;
                            accessible-role: button;
                            accessible-label: "Made with Slint";
                            accessible-action-default => { root.open-slint(); }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-slint(); }
                            }
                        }
                    }
                    Text {
                        text: @tr("Not an official Guild Wars 2 product. A fan project by breakbar.cc. Guild Wars 2 is a trademark of ArenaNet.");
                        font-size: Theme.fs-help;
                        color: Theme.text-dim;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
