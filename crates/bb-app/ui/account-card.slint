// One account in the list (design hand-off: DESIGN.md, "Account-Eintrag").

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Spinner, Button, IconButton, CheckBox, Badge, MenuItem, Elevated, FocusRing } from "components.slint";

export enum AccountState {
    idle,
    /// Has no `Local.dat` yet: the next start sets up the login.
    needs-login,
    /// Queued or starting (waiting for its `Local.dat`).
    starting,
    running,
    stopping,
    /// A Steam account while another Steam account runs.
    locked,
    /// The last start failed or the client exited with an error.
    error,
}

export struct AccountRow {
    id: int,
    name: string,
    /// Display name of the platform: "ArenaNet" or "Steam".
    provider: string,
    steam: bool,
    state: AccountState,
    /// Local start time ("14:02") while running.
    since: string,
    /// Short reason shown after "Error · ".
    detail: string,
    /// The client's raw OS process handle while running (0 otherwise); only used by Rust to stop it.
    handle: int,
    selected: bool,
    /// Companion apps (such as Blish HUD) start together with this account.
    has-companions: bool,
    /// A companion app is running for this account's client.
    addon-active: bool,
}

component StatusLabel {
    in property <AccountRow> account;
    property <color> tone: account.state == AccountState.needs-login ? Theme.warn
        : account.state == AccountState.starting ? Theme.accent
        : account.state == AccountState.running ? Theme.ok
        : account.state == AccountState.error ? Theme.error
        : account.state == AccountState.locked ? Theme.text-dim
        : Theme.text-muted;
    property <string> main: account.state == AccountState.needs-login ? @tr("Login required")
        : account.state == AccountState.starting ? @tr("Starting…")
        : account.state == AccountState.running ? @tr("Running")
        : account.state == AccountState.stopping ? @tr("Stopping…")
        : account.state == AccountState.locked ? @tr("Locked")
        : account.state == AccountState.error ? @tr("Error")
        : @tr("Ready");
    property <string> suffix: account.state == AccountState.running && account.since != "" ? @tr(" · since {}", account.since)
        : account.state == AccountState.locked ? @tr(" · Steam running")
        : account.state == AccountState.error && account.detail != "" ? " · " + account.detail
        : "";

    HorizontalLayout {
        spacing: 5px;
        if account.state == AccountState.starting || account.state == AccountState.stopping: Spinner {
            y: (parent.height - self.height) / 2;
            color: root.tone;
        }
        if account.state != AccountState.starting && account.state != AccountState.stopping: Icon {
            y: (parent.height - self.height) / 2;
            size: 13px;
            weight: 2;
            color: root.tone;
            path: account.state == AccountState.needs-login ? Icons.key
                : account.state == AccountState.running ? Icons.dot
                : account.state == AccountState.error ? Icons.xcircle
                : account.state == AccountState.locked ? Icons.lock
                : Icons.ring;
            fill-path: account.state == AccountState.running ? Icons.dot-fill : "";
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            Text {
                vertical-alignment: center;
                font-size: 12.5px;
                font-weight: 500;
                color: root.tone;
                text: root.main;
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                vertical-alignment: center;
                overflow: elide;
                font-size: 12.5px;
                color: Theme.text-dim;
                text: root.suffix;
            }
        }
    }
}

export component AccountCard {
    in property <AccountRow> account;
    /// Narrow window: icon-only action button.
    in property <bool> compact;
    /// Left behind while this account is being dragged (35 % opacity).
    in property <bool> placeholder;
    /// The copy that follows the pointer while dragging.
    in property <bool> dragging;

    callback action();
    callback toggle-selected();
    callback edit();
    callback duplicate();
    callback create-shortcut();
    callback open-folder();
    callback request-delete();
    /// Keyboard reordering: -1 = up, +1 = down.
    callback move-by(int);
    /// Dragging by the grip; `y` is relative to the top of this card.
    callback drag-started(length);
    callback drag-moved(length);
    callback drag-ended();

    public function open-menu() {
        menu.show();
    }

    property <bool> active: account.state == AccountState.starting || account.state == AccountState.running
        || account.state == AccountState.stopping;
    property <bool> busy: account.state == AccountState.starting || account.state == AccountState.stopping;
    property <bool> show-grip: hover.has-hover || focus.has-focus || root.dragging;

    height: Theme.row-height;
    opacity: root.placeholder ? 0.35 : 1;
    forward-focus: focus;
    accessible-role: list-item;
    accessible-label: account.name;

    Rectangle {
        border-radius: Theme.radius-card;
        border-width: 1px;
        background: root.dragging ? Theme.elevated
            : account.selected ? Theme.accent-soft
            : hover.has-hover ? Theme.surface-2 : Theme.surface;
        border-color: root.dragging ? Theme.line-3
            : account.selected ? Theme.accent-line
            : hover.has-hover ? Theme.line-2 : Theme.line;
        drop-shadow-color: root.dragging ? Theme.shadow-color : transparent;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 18px;
    }
    if focus.has-focus && !root.dragging: FocusRing {
        radius: Theme.radius-card;
        around-width: root.width;
        around-height: root.height;
    }

    hover := TouchArea {
        clicked => { focus.focus(); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                focus.focus();
                menu.show();
            }
        }
    }

    // Turned off: `hover` above already calls `.focus()` itself on every path. See
    // `Activation`'s doc comment in components.slint for why FocusScope's own click-to-focus
    // otherwise steals the first click from a sibling TouchArea.
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == " " {
                root.toggle-selected();
                return accept;
            }
            if event.text == "\n" {
                root.action();
                return accept;
            }
            if event.text == Key.F2 {
                root.edit();
                return accept;
            }
            if event.text == Key.Delete && !root.active {
                root.request-delete();
                return accept;
            }
            if event.modifiers.control && (event.text == "d" || event.text == "D") {
                root.duplicate();
                return accept;
            }
            if event.modifiers.alt && event.text == Key.UpArrow {
                root.move-by(-1);
                return accept;
            }
            if event.modifiers.alt && event.text == Key.DownArrow {
                root.move-by(1);
                return accept;
            }
            if (event.modifiers.shift && event.text == Key.F10) || event.text == Key.Menu {
                menu.show();
                return accept;
            }
            reject
        }
    }

    // Drag handle over the grip column (full height, so the pointer is easy to catch). Declared
    // before the row's own controls so a real control (e.g. the checkbox, whose hit area is
    // padded beyond its visible bounds and reaches slightly into this column) always wins over
    // the drag catcher where the two overlap.
    TouchArea {
        x: 0;
        width: 22px;
        mouse-cursor: move;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                focus.focus();
                root.drag-started(self.mouse-y);
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.drag-ended();
            }
        }
        moved => {
            if self.pressed {
                root.drag-moved(self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 8px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;

        // Grip: only visible on hover, focus or while dragging; the drag area is above.
        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.grip;
            size: 14px;
            color: Theme.text-dim;
            opacity: root.show-grip ? 1 : 0;
        }

        CheckBox {
            y: (parent.height - self.height) / 2;
            checked: account.selected;
            label: @tr("Select {}", account.name);
            toggled => { root.toggle-selected(); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            opacity: account.state == AccountState.locked ? 0.6 : 1;

            Text {
                text: account.name;
                font-size: Theme.fs-name;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 7px;
                Badge {
                    text: account.steam ? "STEAM" : "ARENANET";
                }
                StatusLabel {
                    horizontal-stretch: 1;
                    account: root.account;
                }
            }
        }

        if account.has-companions: Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.layers;
            color: account.addon-active ? Theme.accent : Theme.text-dim;
            accessible-role: image;
            accessible-label: account.addon-active ? @tr("Companion app running") : @tr("Companion apps start with it");
        }

        Button {
            y: (parent.height - self.height) / 2;
            min-width-hint: root.compact ? 32px : 76px;
            icon-only: root.compact;
            enabled: !root.busy && account.state != AccountState.locked && !(account.state == AccountState.running && account.handle == 0);
            text: account.state == AccountState.running || root.busy ? "Stop"
                : account.state == AccountState.needs-login ? "Login"
                : account.state == AccountState.error ? @tr("Retry")
                : "Play";
            icon: account.state == AccountState.running || root.busy ? Icons.stop
                : account.state == AccountState.needs-login ? Icons.login
                : account.state == AccountState.error ? Icons.refresh
                : Icons.play;
            icon-color: account.state == AccountState.running || root.busy || account.state == AccountState.error ? Theme.error
                : account.state == AccountState.needs-login ? Theme.warn
                : Theme.accent;
            clicked => { root.action(); }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            size: 28px;
            icon: Icons.more;
            label: @tr("More actions for {}", account.name);
            clicked => { menu.show(); }
        }
    }

    // Starting: thin progress strip along the bottom edge.
    if account.state == AccountState.starting: Rectangle {
        x: 10px;
        y: parent.height - 5px;
        width: parent.width - 20px;
        height: 2px;
        clip: true;
        Rectangle {
            border-radius: 1px;
            background: Theme.line-2;
        }
        Rectangle {
            property <float> phase: mod(animation-tick() / 1ms, 1400) / 1400;
            width: parent.width * 0.35;
            x: (parent.width + self.width) * self.phase - self.width;
            border-radius: 1px;
            background: Theme.accent;
        }
    }

    menu := PopupWindow {
        x: root.width - 250px - 8px;
        y: root.height - 6px;
        width: 250px;
        close-policy: close-on-click-outside;

        Elevated {
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    text: @tr("Edit");
                    icon: Icons.pencil;
                    shortcut: "F2";
                    activated => {
                        menu.close();
                        root.edit();
                    }
                }
                MenuItem {
                    text: @tr("Duplicate");
                    icon: Icons.copy;
                    shortcut: @tr("Ctrl+D");
                    activated => {
                        menu.close();
                        root.duplicate();
                    }
                }
                MenuItem {
                    text: @tr("Create desktop shortcut");
                    icon: Icons.monitor;
                    activated => {
                        menu.close();
                        root.create-shortcut();
                    }
                }
                MenuItem {
                    text: @tr("Open profile folder");
                    icon: Icons.folder;
                    activated => {
                        menu.close();
                        root.open-folder();
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle {
                        height: 1px;
                        background: Theme.line-2;
                    }
                }
                MenuItem {
                    text: @tr("Delete");
                    icon: Icons.trash;
                    shortcut: @tr("Del");
                    danger: true;
                    enabled: !root.active;
                    activated => {
                        menu.close();
                        root.request-delete();
                    }
                }
            }
        }
    }
}
